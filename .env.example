# Polymarket credentials (POLY_PROXY wallet — exported private key from polymarket.com/settings)
POLY_PRIVATE_KEY=0x...
POLY_FUNDER_ADDRESS=0x...  # Your proxy wallet address

# Telegram alerts (optional — bot works without these, just no alerts)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Portfolio tracking baseline
INITIAL_PORTFOLIO_USDC=100
